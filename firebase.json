{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/privacy-policy",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/auth/callback",
        "destination": "/auth-callback.html"
      }
    ]
  }
}
